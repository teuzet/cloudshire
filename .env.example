OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Опционально: 1/0. Если не задано — бот включится сам при наличии TELEGRAM_BOT_TOKEN.
# TELEGRAM_ENABLED=1

PORT=3000
# SERVER_HOST=127.0.0.1
CLOUDSHIRE_CONFIG=config/default.yaml

# Storage: yaml (локально) | mongo (Heroku / Atlas)
# STORAGE_DRIVER=mongo
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=cloudshire

# Админка (HTTP Basic). На Heroku обязательно.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Тики (по умолчанию 2 часа из config)
# TICK_INTERVAL_HOURS=2
# TICK_ENABLED=1

# Логи: на Heroku file выключен (DYNO). Локально можно LOG_TO_FILE=0
# LOG_LEVEL=info
# LOG_TO_FILE=1
