OPENAI_API_KEY=

# Claude / Anthropic (mystery annotation experiment)
ANTHROPIC_API_KEY=

# --- Что поднимаем ---------------------------------------------------
# Две независимые веб-поверхности:
#   WEB_PLAY=1  — игровой клиент на /play (без пароля, для локальной игры)
#   WEB_ADMIN=1 — админка на /admin (за Basic auth)
# Локально по умолчанию включены оба; на Railway/Heroku — только админка.
WEB_PLAY=1
WEB_ADMIN=1
# Отладочные кнопки в игровом клиенте (тик, вайп мира):
# локально включены, на хостинге — только явно.
# WEB_PLAY_DEV=0

PORT=3000
# SERVER_HOST=127.0.0.1
CLOUDSHIRE_CONFIG=config/default.yaml

# --- Хранилище -------------------------------------------------------
# yaml — локальные файлы в ./data (ничего ставить не нужно)
# mongo — Atlas для хостинга
STORAGE_DRIVER=yaml
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=cloudshire

# --- Телеграм --------------------------------------------------------
# Без токена бот не поднимается. Явно выключить: TELEGRAM_ENABLED=0
TELEGRAM_ENABLED=0
# TELEGRAM_BOT_TOKEN=

# --- Админка (Basic auth) --------------------------------------------
# На хостинге обязательно; локально можно оставить пустым.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Тики ------------------------------------------------------------
# Локально удобно быстрее, чем 2 часа из конфига.
# TICK_INTERVAL_HOURS=2
# TICK_ENABLED=0

# --- Логи ------------------------------------------------------------
# LOG_LEVEL=info
# LOG_TO_FILE=1
